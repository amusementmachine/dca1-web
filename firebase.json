{
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "headers": [
      {
        "source": "**/*.@(js|css|html)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ],
    "predeploy": [
      "npm run build"
    ]
  },
  "firestore": {
    "database": "dca1",
    "rules": "firestore.rules"
  },
  "auth": {
    "providers": {
      "googleSignIn": {
        "oAuthBrandDisplayName": "DCA1 Dashboard",
        "supportEmail": "theamusementmachine@gmail.com"
      }
    }
  },
  "emulators": {
    "ui": {
      "enabled": false
    },
    "firestore": {
      "port": 8180
    }
  }
}
